{
    "manifest_version": 3,
    "name": "TITS - Paste & Editor Unlocker",
    "short_name": "TITS",
    "version": "1.2.2",
    "description": "TITS Companion: Enables pasting on any website, unlocks Ace & Monaco editors, and types like a human with realistic typos & backspace fixes.",
    "permissions": ["activeTab", "storage", "contextMenus", "clipboardRead", "scripting"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content-main.js"],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "world": "MAIN"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["content-isolated.js"],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["content-main.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "TITS - Paste & Editor Unlocker"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "commands": {
        "force-paste": {
            "suggested_key": {
                "default": "Alt+V",
                "mac": "Alt+V"
            },
            "description": "Force paste clipboard into focused element or editor"
        },
        "toggle-typing-paste": {
            "suggested_key": {
                "default": "Alt+Shift+V",
                "mac": "Alt+Shift+V"
            },
            "description": "Toggle human typing paste mode"
        },
        "stop-typing": {
            "suggested_key": {
                "default": "Alt+X",
                "mac": "Alt+X"
            },
            "description": "Stop current human typing simulation"
        }
    }
}
